# Database
# Paste the PostgreSQL connection string from Supabase Project Settings > Database.
# Use the Session Pooler connection string when direct IPv6 connectivity is unavailable.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-HOST]:5432/postgres

# Application
APP_NAME=Textile Manufacturing Intelligence System
API_PREFIX=/api/v1
APP_DEBUG=True
ECHO_SQL=False

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
GOOGLE_CLIENT_ID=
WORK_TIMEZONE=Asia/Kolkata
INITIAL_ADMIN_EMAIL=admin@everestmills.com
INITIAL_ADMIN_NAME=Factory Administrator
INITIAL_ADMIN_PASSWORD=

# Environment
ENVIRONMENT=development
