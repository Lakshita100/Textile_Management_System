# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/textile_manufacturing

# Application
APP_NAME=Textile Manufacturing Intelligence System
API_PREFIX=/api/v1
DEBUG=False
SQL_ECHO=False

# CORS (local frontend dev server)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Environment
ENVIRONMENT=development

# Recommendation weights (initial business-rule weights; not validated factory parameters)
REC_WEIGHT_EFFICIENCY=0.40
REC_WEIGHT_WORKLOAD=0.35
REC_WEIGHT_QUALITY=0.25
REC_ALGORITHM_VERSION=rule-based-v1
REC_NEUTRAL_SCORE=50.0
