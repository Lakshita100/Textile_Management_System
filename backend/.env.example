# Database
# Local development/demo default (zero-config, ACID, ships with Python):
DATABASE_URL=sqlite:///./textile_dev.db

# Local PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/textile_manufacturing

# Supabase (PostgreSQL 17):
# NOTE: the direct host `db.<project-ref>.supabase.co` is IPv6-only and will
# not resolve from IPv4-only networks. Use the IPv4 Transaction pooler instead
# (Dashboard → Connect → Connection string → Transaction pooler), URL-encode
# any special characters in the password (e.g. @ → %40):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password-url-encoded>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# JWT (placeholder - real deployment requires tested auth)
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Application
APP_NAME=Textile Manufacturing Intelligence System
API_PREFIX=/api/v1
DEBUG=True
ECHO_SQL=False

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Environment
ENVIRONMENT=development
